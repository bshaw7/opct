# Final stage only: use a binary cross-compiled on the build host
# (GOOS=linux GOARCH=amd64) to avoid compiling Go under Rosetta/QEMU
# emulation, which segfaults on some toolchain/dependency combinations.
FROM --platform=linux/amd64 quay.io/fedora/fedora-minimal:41
LABEL io.k8s.display-name="OPCT" \
      io.k8s.description="OpenShift/OKD Conformance Tool is designed to run conformance suites to validate custom installations." \
      io.opct.tags="opct,conformance,openshift,tests,e2e" \
      io.opct.os="linux" io.opct.arch="amd64"

COPY build/opct-linux-amd64 /usr/bin/opct

CMD ["/usr/bin/opct"]
